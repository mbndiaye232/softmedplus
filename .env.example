# Configuration de SoftMed Teleconsultation
# Copier ce fichier en .env puis renseigner les valeurs : cp .env.example .env

# --- Serveur ---
PORT=5050
NODE_ENV=development

# URL publique de l'application, utilisee dans les liens envoyes par email
# (reinitialisation du mot de passe patient). Sans SSL en local.
PUBLIC_BASE_URL=http://127.0.0.1:5050

# --- Base de donnees PostgreSQL ---
# En local : renseigner DB_HOST/DB_PORT/DB_USER/DB_PASSWORD/DB_NAME.
# En production (Render) : renseigner DATABASE_URL, qui a la priorite sur DB_*.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=softmedplus
# DATABASE_URL=postgresql://user:motdepasse@host:5432/base
DB_SSL=false

# --- Securite ---
# Generer des valeurs aleatoires longues, differentes l'une de l'autre :
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
HMAC_SECRET=

# --- Email sortant (SMTP) ---
# Sans ces variables, les emails sont simules : ils sont journalises dans la
# console du serveur au lieu d'etre envoyes.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- SMS et WhatsApp (rappels de rendez-vous, code de double authentification) ---
# Laisser vide : les envois sont simules et journalises cote serveur.
# Aucun fournisseur n'est implemente a ce jour ; renseigner une valeur ici
# provoque une erreur tant que le connecteur correspondant n'est pas ecrit
# (voir utils/sms.js et utils/whatsapp.js).
SMS_PROVIDER=
WHATSAPP_PROVIDER=

# --- Stockage des fichiers (Cloudflare R2, compatible S3) ---
# Documents et images deposes dans les dossiers patients.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET_NAME=softmedplus-storage
R2_PUBLIC_URL=
